generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model SyncLog {
  id          Int       @id @default(autoincrement())
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String
  trigger     String
  message     String?
}

model DataCache {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model BroadcastLog {
  id          Int       @id @default(autoincrement())
  type        String    // "reorder" | "alert-pdf"
  sentAt      DateTime  @default(now())
  status      String    // "SUCCESS" | "FAILED"
  target      String    // WA number/group
  branchId    Int?
  warehouseId Int?
  message     String?
  itemCount   Int?
}

// Master Data: Mapping kota -> area/cluster/sub-cluster
model CityCluster {
  id         Int      @id @default(autoincrement())
  city       String   @unique
  province   String?
  area       String
  cluster    String?
  subCluster String?
  updatedAt  DateTime @updatedAt
}

// Master Data: Berat & dimensi produk per satuan terkecil
model ProductDimension {
  id        Int      @id @default(autoincrement())
  itemNo    String   @unique
  itemName  String?
  weightKg  Float?
  lengthCm  Float?
  widthCm   Float?
  heightCm  Float?
  updatedAt DateTime @updatedAt
}
