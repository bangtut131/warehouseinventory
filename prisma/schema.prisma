generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model SyncLog {
  id          Int       @id @default(autoincrement())
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  status      String
  trigger     String
  message     String?
}

model DataCache {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model BroadcastLog {
  id          Int       @id @default(autoincrement())
  type        String    // "reorder" | "alert-pdf"
  sentAt      DateTime  @default(now())
  status      String    // "SUCCESS" | "FAILED"
  target      String    // WA number/group
  branchId    Int?
  warehouseId Int?
  message     String?
  itemCount   Int?
}

// Master Data: Mapping kota -> area/cluster/sub-cluster
model CityCluster {
  id         Int      @id @default(autoincrement())
  city       String   @unique
  province   String?
  area       String
  cluster    String?
  subCluster String?
  updatedAt  DateTime @updatedAt
}

// Master Data: Berat & dimensi produk per satuan terkecil
model ProductDimension {
  id        Int      @id @default(autoincrement())
  itemNo    String   @unique
  itemName  String?
  weightKg     Float?
  lengthCm     Float?
  widthCm      Float?
  heightCm     Float?
  qtyPerCarton Int?
  updatedAt    DateTime @updatedAt
}

// Master Data: Jenis kendaraan pengiriman (fleet management)
model VehicleType {
  id           Int      @id @default(autoincrement())
  name         String   @unique       // e.g. "Pickup", "CDE", "CDD", "Fuso", "Tronton"
  maxWeightKg  Float                  // Kapasitas maks berat (kg)
  maxVolumeM3  Float                  // Kapasitas maks volume (m3)
  costPerTrip  Float?                 // Biaya per trip (Rp), optional
  sortOrder    Int      @default(0)   // Urutan tampil (kecil ke besar)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// RBAC: Role definitions with menu access and data visibility control
model AppRole {
  id             Int       @id @default(autoincrement())
  name           String    @unique       // "Admin", "Manager", "Staff"
  description    String?
  allowedMenus   Json      @default("[]") // ["dashboard","so","routing",...]
  hiddenColumns  Json      @default("[]") // ["col:value","col:cost","col:margin",...]
  isDefault      Boolean   @default(false) // auto-assign to new registered users
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  users          AppUser[]
}

// RBAC: User accounts
model AppUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String                     // bcrypt hashed
  fullName  String?
  roleId    Int
  role      AppRole  @relation(fields: [roleId], references: [id])
  status    String   @default("pending") // pending, approved, rejected
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Gudang Khusus: Daily stock snapshot per item per warehouse
model SpecialWarehouseSnapshot {
  id          Int      @id @default(autoincrement())
  warehouseId Int
  warehouseName String?
  itemNo      String
  itemName    String?
  quantity    Float
  snapshotAt  DateTime @default(now())

  @@index([warehouseId, itemNo])
  @@index([snapshotAt])
}

// Gudang Khusus: Track kapan item pertama kali muncul di gudang khusus
model SpecialWarehouseFirstSeen {
  id          Int      @id @default(autoincrement())
  warehouseId Int
  itemNo      String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  isActive    Boolean  @default(true) // false = item sudah keluar (qty 0)

  @@unique([warehouseId, itemNo])
}
